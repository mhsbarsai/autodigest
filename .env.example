# Secrets — NEVER commit this file. Copy to .env and fill in values.
# See README.md for instructions on obtaining each key.

# AI Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Distribution Provider: "resend" (default) or "beehiiv"
DISTRIBUTION_PROVIDER=resend

# Resend Settings (Get free API key at https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=NeuralBrief <onboarding@resend.dev>
RESEND_TO_EMAIL=your_email@gmail.com
# RESEND_AUDIENCE_ID=your_audience_id_here

# Beehiiv Settings (optional)
BEEHIIV_API_KEY=your_beehiiv_api_key_here
BEEHIIV_PUBLICATION_ID=your_publication_id_here
GCS_BUCKET_NAME=autodigest-cache

# Optional overrides
NEWSLETTER_NAME=NeuralBrief
SEND_HOUR_UTC=12
SEND_MINUTE_UTC=0
LOG_LEVEL=INFO
