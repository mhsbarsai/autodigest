# Secrets — NEVER commit this file. Copy to .env and fill in values.
# See README.md for instructions on obtaining each key.

# AI Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Distribution Provider: "resend" (default) or "beehiiv"
DISTRIBUTION_PROVIDER=resend

# Resend Settings (Get free API key at https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Creavora <newsletter@creavora.my.id>
RESEND_TO_EMAIL=your_email@gmail.com
# RESEND_AUDIENCE_ID=your_audience_id_here

# Beehiiv Settings (optional)
BEEHIIV_API_KEY=your_beehiiv_api_key_here
BEEHIIV_PUBLICATION_ID=your_publication_id_here
GCS_BUCKET_NAME=autodigest-cache

# Optional overrides
NEWSLETTER_NAME=Creavora
SEND_HOUR_UTC=23
SEND_MINUTE_UTC=0
LOG_LEVEL=INFO

# ==============================================================================
# Automated Social Media Distribution (100% Free & Hands-Free)
# ==============================================================================
# Telegram Channel / Group (Recommended — Free, instant, high open-rate)
# 1. Create a bot with @BotFather on Telegram to get TELEGRAM_BOT_TOKEN
# 2. Add your bot as Admin to your Telegram Channel
# 3. Put your public channel username (e.g. @creavora_ai) or chat ID below:
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# TELEGRAM_CHAT_ID=@creavora_ai

# Discord Webhook (Fastest — 1 minute setup)
# In Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# X / Twitter API v2 (Optional)
# Obtain from https://developer.x.com (Free tier app credentials)
# TWITTER_API_KEY=your_twitter_api_key
# TWITTER_API_SECRET=your_twitter_api_secret
# TWITTER_ACCESS_TOKEN=your_twitter_access_token
# TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# Bluesky AT Protocol (100% Free, open, high AI researcher adoption)
# 1. Create account on https://bsky.app
# 2. Go to Settings -> Privacy & Security -> App Passwords -> Add App Password
# BLUESKY_HANDLE=creavora.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Universal Social Webhook Bridge (Make.com / n8n / Zapier)
# Automatically publishes to LinkedIn, X/Twitter, Threads, and Instagram via webhook ($0/mo)
# 1. Create a Custom Webhook module in Make.com or n8n
# 2. Paste your webhook URL below:
# SOCIAL_WEBHOOK_URL=https://hook.eu2.make.com/your-custom-webhook-id

